<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/car_surface" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/car_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/browse_back" style="@style/Widget.YouTubeCar.ToolbarButton" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/browse_back" android:visibility="gone" />
        <ImageView android:id="@+id/car_brand" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_brand_play" android:contentDescription="@null" />
        <TextView android:id="@+id/browse_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/car_projection_label" android:textColor="@color/car_on_surface" android:textSize="22sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/browse_layout_toggle" style="@style/Widget.YouTubeCar.ToolbarButton" android:src="@drawable/ic_car_view_grid" android:contentDescription="@string/browse_show_cards" />
        <ImageButton android:id="@+id/browse_refresh_button" style="@style/Widget.YouTubeCar.ToolbarButton" android:src="@drawable/ic_refresh" android:contentDescription="@string/browse_refresh" />
        <ImageButton android:id="@+id/browse_search_button" style="@style/Widget.YouTubeCar.ToolbarButton" android:src="@drawable/ic_search_yt" android:contentDescription="@string/browse_search_hint" />
        <ImageButton android:id="@+id/browse_settings_button" style="@style/Widget.YouTubeCar.ToolbarButton" android:src="@drawable/ic_settings" android:contentDescription="@string/browse_settings" />
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:clipToPadding="false" android:fillViewport="false" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button style="@style/Widget.YouTubeCar.TextButton" android:id="@+id/car_tab_home" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@drawable/bg_car_button" android:minWidth="92dp" android:paddingHorizontal="18dp" android:text="@string/browse_home" android:textAllCaps="false" android:textColor="@color/car_on_surface" />
            <Button style="@style/Widget.YouTubeCar.TextButton" android:id="@+id/car_tab_subscriptions" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_car_button" android:minWidth="92dp" android:paddingHorizontal="18dp" android:text="@string/browse_subscriptions" android:textAllCaps="false" android:textColor="@color/car_on_surface" />
            <Button style="@style/Widget.YouTubeCar.TextButton" android:id="@+id/car_tab_shorts" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_car_button" android:minWidth="92dp" android:paddingHorizontal="18dp" android:text="@string/browse_shorts" android:textAllCaps="false" android:textColor="@color/car_on_surface" />
            <Button style="@style/Widget.YouTubeCar.TextButton" android:id="@+id/car_tab_popular" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_car_button" android:minWidth="92dp" android:paddingHorizontal="18dp" android:text="@string/browse_search_popular" android:textAllCaps="false" android:textColor="@color/car_on_surface" />
            <Button style="@style/Widget.YouTubeCar.TextButton" android:id="@+id/car_tab_history" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_car_button" android:minWidth="92dp" android:paddingHorizontal="18dp" android:text="@string/browse_history" android:textAllCaps="false" android:textColor="@color/car_on_surface" />
            <Button style="@style/Widget.YouTubeCar.TextButton" android:id="@+id/car_tab_playlist" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:background="@drawable/bg_car_button" android:minWidth="110dp" android:paddingHorizontal="18dp" android:text="@string/browse_my_playlist" android:textAllCaps="false" android:textColor="@color/car_on_surface" />
        </LinearLayout>
    </HorizontalScrollView>
    <HorizontalScrollView android:id="@+id/car_chip_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:clipToPadding="false" android:scrollbars="none" android:visibility="gone">
        <LinearLayout android:id="@+id/car_chip_strip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/browse_status_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ProgressBar android:id="@+id/browse_progress" style="?android:attr/progressBarStyleSmall" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="10dp" android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/browse_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/car_on_surface_variant" android:textSize="14sp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/browse_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="8dp" />
</LinearLayout>