<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginHorizontal="6dp" android:layout_marginBottom="14dp" android:orientation="vertical" android:background="@drawable/bg_car_button_quiet" android:clickable="true" android:focusable="true">
 <de.uni.youtubeaa.car.VideoThumbnailView android:id="@+id/row_cover" android:layout_width="match_parent" android:layout_height="wrap_content" android:scaleType="centerCrop" android:background="@drawable/bg_car_cover" android:clipToOutline="true" android:contentDescription="@null" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingTop="8dp" android:orientation="horizontal" android:gravity="top">
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
   <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/car_on_surface" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
   <TextView android:id="@+id/row_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/car_on_surface_variant" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
  <Button android:id="@+id/row_action" style="@style/Widget.YouTubeCar.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:padding="0dp" android:background="@drawable/bg_car_button_quiet" android:text="@string/playlist_add_symbol" android:textSize="22sp" android:contentDescription="@string/browse_playlist_add" />
 </LinearLayout>
</LinearLayout>
