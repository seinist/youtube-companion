<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/bg_car_button_quiet" android:gravity="center_vertical" android:minHeight="92dp" android:orientation="horizontal" android:padding="10dp">
    <ImageView android:id="@+id/row_cover" android:layout_width="136dp" android:layout_height="76dp" android:layout_marginEnd="14dp" android:background="@drawable/bg_car_cover" android:clipToOutline="true" android:contentDescription="@null" android:scaleType="centerCrop" android:visibility="gone" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/car_on_surface" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/row_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/car_on_surface_variant" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
    <Button android:id="@+id/row_action" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="10dp" android:background="@drawable/bg_car_button_quiet" android:minWidth="52dp" android:padding="0dp" android:text="@string/playlist_add_symbol" android:textAllCaps="false" android:textColor="@color/car_on_surface" android:textSize="22sp" android:visibility="gone" />
</LinearLayout>