<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/pref_category_account">
        <Preference
            android:key="youtube_account"
            android:title="@string/pref_account_title"
            android:summary="@string/pref_account_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_player">
        <ListPreference
            android:key="default_tab"
            android:title="@string/pref_default_tab"
            android:entries="@array/tab_entries"
            android:entryValues="@array/tab_values"
            android:defaultValue="home"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="autoplay"
            android:title="@string/pref_autoplay"
            android:summary="@string/pref_autoplay_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="phone_audio_only"
            android:title="@string/pref_phone_audio_first"
            android:summary="@string/pref_phone_audio_first_summary"
            android:defaultValue="false" />
        <ListPreference
            android:key="video_quality"
            android:title="@string/pref_phone_quality"
            android:entries="@array/quality_entries"
            android:entryValues="@array/quality_values"
            android:defaultValue="auto"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="car_video_quality"
            android:title="@string/pref_car_quality"
            android:entries="@array/car_quality_entries"
            android:entryValues="@array/car_quality_values"
            android:defaultValue="auto"
            android:summary="@string/pref_car_quality_summary"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="playback_speed"
            android:title="@string/pref_default_speed"
            android:entries="@array/playback_speed_entries"
            android:entryValues="@array/playback_speed_values"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="playback_mode"
            android:title="@string/pref_default_mode"
            android:entries="@array/playback_mode_entries"
            android:entryValues="@array/playback_mode_values"
            android:defaultValue="video"
            android:summary="@string/pref_default_mode_summary"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="video_backend"
            android:title="@string/pref_backend"
            android:entries="@array/backend_entries"
            android:entryValues="@array/backend_values"
            android:defaultValue="exoplayer"
            android:summary="@string/pref_backend_summary" />
        <ListPreference
            android:key="car_video_surface"
            android:title="@string/pref_car_surface"
            android:entries="@array/car_surface_entries"
            android:entryValues="@array/car_surface_values"
            android:defaultValue="surface"
            android:summary="@string/pref_car_surface_summary"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="require_parked"
            android:title="@string/pref_require_parked"
            android:summary="@string/pref_require_parked_summary"
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_audio">
        <ListPreference
            android:key="audio_language"
            android:title="@string/pref_audio_language"
            android:entries="@array/audio_language_entries"
            android:entryValues="@array/audio_language_values"
            android:defaultValue="original"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:key="audio_bitrate"
            android:title="@string/pref_audio_quality"
            android:entries="@array/audio_bitrate_entries"
            android:entryValues="@array/audio_bitrate_values"
            android:defaultValue="auto"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_appearance">
        <SwitchPreferenceCompat
            android:key="phone_browse_cards"
            android:title="@string/pref_phone_cards"
            android:summary="@string/pref_phone_cards_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="car_browse_cards"
            android:title="@string/pref_car_cards"
            android:summary="@string/pref_car_cards_summary"
            android:defaultValue="false" />
        <ListPreference
            android:key="thumbnail_quality"
            android:title="@string/pref_thumbnail_quality"
            android:entries="@array/thumbnail_quality_entries"
            android:entryValues="@array/thumbnail_quality_values"
            android:defaultValue="auto"
            android:summary="@string/pref_thumbnail_quality_summary"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_data">
        <ListPreference
            android:key="cache_size_mb"
            android:title="@string/pref_cache_size"
            android:entries="@array/cache_entries"
            android:entryValues="@array/cache_values"
            android:defaultValue="@string/default_cache_size_mb"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="history_enabled"
            android:title="@string/pref_history"
            android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_diagnostics">
        <Preference
            android:key="share_head_unit_logs"
            android:title="@string/pref_share_hu_logs"
            android:summary="@string/pref_share_hu_logs_summary" />
        <Preference
            android:key="clear_head_unit_logs"
            android:title="@string/pref_clear_hu_logs"
            android:summary="@string/pref_clear_hu_logs_summary" />
    </PreferenceCategory>

</PreferenceScreen>
